{
  "name": "fa-project",
  "version": "1.0.0",
  "private": true,
  "description": "Final project of FE Academy",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "codegen": "npm run codegen --workspaces --if-present",
    "infra:up": "docker compose -f infra/keycloak/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/keycloak/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module"
}
