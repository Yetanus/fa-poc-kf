{
  "name": "@fa/bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "codegen": "graphql-codegen --config codegen.ts && npm run codegen:spaceflight",
    "codegen:spaceflight": "npx -y openapi-typescript@7.13.0 src/adapters/spaceflight/openapi.yaml -o src/generated/spaceflight.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fa/contracts": "*",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "graphql": "^17.1.0",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^6.1.0",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  }
}
